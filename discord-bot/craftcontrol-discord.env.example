# CraftControl Discord bridge — copy to /etc/craftcontrol-discord.env, fill in,
# then: chmod 600 /etc/craftcontrol-discord.env
#
# This file holds a bot token and the list of people allowed to run root-level
# commands on CT102. It must never be committed to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Discord Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Who may command the bot:
#
#   allowlist  (default) — only the user IDs in DISCORD_ALLOWED_USER_IDS below.
#   channel              — anyone who can post in a watched channel. Discord's
#                          channel permissions become the access control.
#
# Pick "channel" only for a private channel you fully trust: from then on,
# whoever can add a member or a role to that channel can hand out root-level
# access to this host without touching any config here.
DISCORD_AUTH_MODE=allowlist

# Comma-separated Discord user IDs allowed to command the bot. Anything from
# anyone else is ignored and logged with a ⛔ reaction.
#
# To get your ID: Discord Settings -> Advanced -> Developer Mode ON, then
# right-click your name -> Copy User ID.
#
# Required in allowlist mode — the service refuses to start when it is empty,
# so a truncated env file can never quietly widen access. Leave it empty in
# channel mode, or fill it in anyway to narrow a shared channel down to a few
# operators: when set, it wins in both modes.
DISCORD_ALLOWED_USER_IDS=

# Comma-separated channel IDs to watch. Right-click a channel -> Copy Channel ID.
# Keep this to a private channel: message content in it is executed as root.
DISCORD_CHANNEL_IDS=

# ── Optional ──────────────────────────────────────────────────────────────────

# Working directory Claude runs in.
CLAUDE_WORKDIR=/opt/craftcontrol

# Path to the Claude Code binary.
CLAUDE_BIN=/root/.local/bin/claude

# Model alias (opus, sonnet, haiku). Leave blank for the account default.
CLAUDE_MODEL=

# Permission mode. Default acceptEdits: auto-approves Bash and edits inside
# CLAUDE_WORKDIR, refuses writes outside it. Do NOT set bypassPermissions — Claude
# Code refuses it outright when running as root, and every job would fail.
CLAUDE_PERMISSION_MODE=acceptEdits

# Hard ceiling on a single job, in seconds. Long refactors and deploys need room.
CLAUDE_TIMEOUT_SECONDS=1800

# How often to poll Discord for new messages, in seconds.
POLL_INTERVAL_SECONDS=3

# Where session ids and read cursors are kept across restarts.
STATE_FILE=/var/lib/craftcontrol-discord/state.json
