# Java / Maven
target/
*.class
*.jar
!plugins/*/target/*-*.jar

# Node
node_modules/
dist/
.next/

# Environment
# Root .env is committed with safe defaults — do NOT ignore it
# deploymentV2/.env is gitignored separately (contains production secrets)
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.iml

# Claude Code
# Shared project config (slash commands, permission allowlist) is committed so it
# reaches CT102 — deploy-v2 resets /opt/craftcontrol to origin/main on every deploy.
# Personal overrides stay local.
.claude/*
!.claude/commands/
!.claude/settings.json
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Prisma
prisma/migrations/dev.db

# Coverage reports
coverage/
deploymentV2/.env
deploymentV2/backups/
settings.local.json
